{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Scratch: debug this build script",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "runtimeArgs": ["--experimental-strip-types", "--no-warnings"]
    },
    {
      "name": "Scratch: debug tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scratch/workbench/test.ts",
      "cwd": "${workspaceFolder}/scratch",
      "runtimeArgs": ["--experimental-strip-types", "--no-warnings"],
      "args": ["--verbose"]
    }
  ]
}
